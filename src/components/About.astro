---
import { getTotalPosts } from "../providers/ghost";

const totalPosts = await getTotalPosts();
const roundedPosts = Math.floor(totalPosts / 5) * 5;
const yearsOfExperience = new Date().getFullYear() - 2022;

interface Stat {
	value: string;
	label: string;
}

const stats: Stat[] = [
	{
		value: `${yearsOfExperience}+`,
		label: "años construyendo software en producción"
	},
	{ value: "20+", label: "proyectos de integración entregados" },
	{ value: `${roundedPosts}+`, label: "artículos técnicos publicados" }
];
---

<section class="section" id="sobre-mi">
	<header class="section-header">
		<h2 class="section-title">Sobre mí</h2>
	</header>

	<div class="content">
		<p class="lead">
			Construyo backend en producción: arquitecturas serverless, APIs y
			las integraciones que hacen hablar a sistemas que <strong
				>no fueron diseñados para entenderse</strong
			>.
		</p>

		<div class="prose">
			<p>
				Hoy desarrollo producto en{" "}
				<a
					href="https://www.buk.cl"
					target="_blank"
					rel="noopener noreferrer">Buk</a
				>, en el área de Finanzas. Antes pasé cuatro años en{" "}
				<a
					href="https://www.cotalker.com"
					target="_blank"
					rel="noopener noreferrer">Cotalker</a
				>, una plataforma SaaS de workflow automation, donde llegué a{
					" "
				}
				<strong>Technical Architect</strong>: arquitectura de
				integraciones para clientes enterprise, mentoría a partners y
				necesidades de negocio traducidas a decisiones técnicas.
			</p>
			<p>
				El hilo es el mismo desde que partí: sistemas que tienen que
				hablarse entre sí y datos que tienen que cuadrar. Empecé
				viéndolo desde la contabilidad, seguí conectando plataformas
				enterprise y hoy lo trabajo en finanzas.
			</p>
			<p>
				Fuera del trabajo construyo proyectos propios, y lo que aprendo
				ahí termina en mi{" "}
				<a
					href="https://blog.etejeda.dev"
					target="_blank"
					rel="noopener noreferrer">blog técnico</a
				>: los problemas reales, las decisiones que tomé y por qué
				funcionaron (o no).
			</p>
		</div>

		<dl class="stats">
			{
				stats.map(stat => (
					<div class="stat">
						<dt>{stat.value}</dt>
						<dd>{stat.label}</dd>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.lead {
		font-size: clamp(1.15rem, 1.5vw, 1.35rem);
		font-weight: 500;
		line-height: 1.45;
		color: var(--text-primary);
		letter-spacing: -0.015em;
		margin-bottom: 1.75rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.lead strong {
		color: var(--accent);
		font-weight: 600;
	}

	.prose p {
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 1.1rem;
		font-size: 1rem;
	}

	.prose strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.prose a {
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 500;
		padding-bottom: 1px;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 100% 1.5px;
		transition:
			color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			background-size 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.prose a:hover {
		color: var(--accent);
		background-size: 100% 3px;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0;
		margin-top: 2.5rem;
		border: 1px solid var(--rule);
		border-radius: 12px;
		overflow: hidden;
		background: var(--bg-surface);
	}

	.stat {
		padding: 1.5rem 1.25rem;
		border-right: 1px solid var(--rule);
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.stat:last-child {
		border-right: none;
	}

	.stat dt {
		font-size: 1.85rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.stat dd {
		color: var(--text-secondary);
		font-size: 0.78rem;
		line-height: 1.35;
	}

	@media (max-width: 600px) {
		.stats {
			grid-template-columns: 1fr;
		}

		.stat {
			border-right: none;
			border-bottom: 1px solid var(--rule);
			flex-direction: row;
			align-items: baseline;
			gap: 1rem;
		}

		.stat:last-child {
			border-bottom: none;
		}

		.stat dt {
			font-size: 1.5rem;
			min-width: 60px;
		}
	}
</style>
