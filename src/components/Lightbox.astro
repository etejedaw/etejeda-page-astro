<dialog class="lightbox" aria-label="Capturas">
	<button type="button" class="lightbox-close" aria-label="Cerrar">
		<svg
			viewBox="0 0 24 24"
			width="20"
			height="20"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
		>
			<line x1="6" y1="6" x2="18" y2="18"></line>
			<line x1="18" y1="6" x2="6" y2="18"></line>
		</svg>
	</button>
	<button
		type="button"
		class="lightbox-nav lightbox-prev"
		aria-label="Anterior"
	>
		<svg
			viewBox="0 0 24 24"
			width="22"
			height="22"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<polyline points="15 18 9 12 15 6"></polyline>
		</svg>
	</button>
	<img class="lightbox-img" src="" alt="" />
	<button
		type="button"
		class="lightbox-nav lightbox-next"
		aria-label="Siguiente"
	>
		<svg
			viewBox="0 0 24 24"
			width="22"
			height="22"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<polyline points="9 18 15 12 9 6"></polyline>
		</svg>
	</button>
	<div class="lightbox-counter" aria-live="polite"></div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox");
	const lightboxImg =
		dialog?.querySelector<HTMLImageElement>(".lightbox-img");
	const closeBtn =
		dialog?.querySelector<HTMLButtonElement>(".lightbox-close");
	const prevBtn = dialog?.querySelector<HTMLButtonElement>(".lightbox-prev");
	const nextBtn = dialog?.querySelector<HTMLButtonElement>(".lightbox-next");
	const counter = dialog?.querySelector<HTMLDivElement>(".lightbox-counter");
	const triggers = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".zoom-trigger")
	);

	let currentIndex = 0;

	function showImage(i: number) {
		if (!triggers.length || !lightboxImg) return;
		currentIndex = (i + triggers.length) % triggers.length;
		const btn = triggers[currentIndex];
		lightboxImg.src = btn.dataset.zoomSrc || "";
		lightboxImg.alt = btn.dataset.zoomAlt || "";
		if (counter) {
			counter.textContent = `${currentIndex + 1} / ${triggers.length}`;
		}
		const single = triggers.length <= 1;
		if (prevBtn) prevBtn.hidden = single;
		if (nextBtn) nextBtn.hidden = single;
		if (counter) counter.hidden = single;
	}

	function openAt(i: number) {
		if (!dialog) return;
		showImage(i);
		document.body.style.overflow = "hidden";
		dialog.showModal();
	}

	function closeLightbox() {
		if (!dialog) return;
		dialog.close();
		document.body.style.overflow = "";
	}

	triggers.forEach((btn, i) => {
		btn.addEventListener("click", () => openAt(i));
	});

	lightboxImg?.addEventListener("click", e => e.stopPropagation());

	closeBtn?.addEventListener("click", e => {
		e.stopPropagation();
		closeLightbox();
	});

	prevBtn?.addEventListener("click", e => {
		e.stopPropagation();
		showImage(currentIndex - 1);
	});

	nextBtn?.addEventListener("click", e => {
		e.stopPropagation();
		showImage(currentIndex + 1);
	});

	dialog?.addEventListener("click", () => closeLightbox());

	dialog?.addEventListener("close", () => {
		document.body.style.overflow = "";
	});

	document.addEventListener("keydown", e => {
		if (!dialog?.open) return;
		if (e.key === "Escape") {
			e.preventDefault();
			closeLightbox();
		} else if (e.key === "ArrowLeft") {
			e.preventDefault();
			showImage(currentIndex - 1);
		} else if (e.key === "ArrowRight") {
			e.preventDefault();
			showImage(currentIndex + 1);
		}
	});
</script>

<style is:global>
	.zoom-trigger {
		display: block;
		padding: 0;
		margin: 0;
		background: none;
		border: 0;
		cursor: zoom-in;
		width: 100%;
		border-radius: inherit;
		position: relative;
	}

	.zoom-trigger:focus-visible {
		outline-offset: 4px;
	}

	.lightbox {
		padding: 0;
		border: 0;
		background: transparent;
		margin: 0;
		inset: 0;
	}

	.lightbox::backdrop {
		background: rgba(0, 0, 0, 0.85);
		backdrop-filter: blur(6px);
	}

	.lightbox[open] {
		display: grid;
		place-items: center;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		max-height: 100vh;
		animation: lightbox-in 0.18s ease-out;
	}

	@keyframes lightbox-in {
		from {
			opacity: 0;
			transform: scale(0.97);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}

	.lightbox-img {
		display: block;
		max-width: 92vw;
		max-height: 88vh;
		width: auto;
		height: auto;
		object-fit: contain;
		border-radius: 8px;
		box-shadow: 0 24px 60px -16px rgba(0, 0, 0, 0.6);
	}

	.lightbox-close,
	.lightbox-nav {
		position: fixed;
		width: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		color: #fff;
		cursor: pointer;
		transition:
			background 0.2s ease,
			border-color 0.2s ease,
			transform 0.2s ease;
		z-index: 2;
	}

	.lightbox-close {
		top: 1.25rem;
		right: 1.25rem;
		width: 40px;
		height: 40px;
	}

	.lightbox-prev {
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-next {
		right: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
	}

	.lightbox-close:hover,
	.lightbox-nav:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: rgba(255, 255, 255, 0.35);
	}

	.lightbox-close:hover {
		transform: scale(1.05);
	}

	.lightbox-prev:hover {
		transform: translate(-2px, -50%);
	}

	.lightbox-next:hover {
		transform: translate(2px, -50%);
	}

	.lightbox-nav[hidden],
	.lightbox-counter[hidden] {
		display: none;
	}

	.lightbox-counter {
		position: fixed;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.4rem 0.85rem;
		background: rgba(0, 0, 0, 0.5);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		color: #fff;
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		z-index: 2;
	}

	@media (max-width: 600px) {
		.lightbox-prev {
			left: 0.6rem;
		}

		.lightbox-next {
			right: 0.6rem;
		}

		.lightbox-close,
		.lightbox-nav {
			width: 40px;
			height: 40px;
		}
	}
</style>
