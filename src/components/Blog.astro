---
import {
	getRecentPosts,
	getPostCountByTag,
	type GhostPost
} from "../providers/ghost";
import ArrowRight from "./icons/ArrowRight.astro";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

interface Serie {
	name: string;
	description: string;
	tagSlug: string;
	posts?: number;
	color: string;
}

const seriesConfig: Serie[] = [
	{
		name: "Integración Replicante",
		description:
			"Casos reales de integración con patrones de diseño: Repository, Factory, Builder. Problemas que no salieron como esperaba y cómo los resolví.",
		tagSlug: "integracion-replicante",
		color: "#06b6d4"
	},
	{
		name: "Protocolo Lambda",
		description:
			"Serverless en producción: middlewares, auth, rate limiting y validación con Middy + Zod.",
		tagSlug: "protocolo-lambda",
		color: "#8b5cf6"
	},
	{
		name: "Pergaminos Rápidos",
		description:
			"Artículos directos al grano: problema, solución, código. Sin rodeos.",
		tagSlug: "pergaminos-rapidos",
		color: "#f59e0b"
	},
	{
		name: "Nexus de Integración",
		description:
			"Arquitectura de integraciones en Cotalker: bots, endpoints, conexiones entrantes y salientes. La guía que la documentación no tiene.",
		tagSlug: "nexus-de-integracion",
		color: "#10b981"
	},
	{
		name: "Hechicería Cotlang",
		description:
			"La guía más completa de Cotlang: desde la sintaxis básica hasta funciones ocultas no documentadas.",
		tagSlug: "hechiceria-cotlang",
		color: "#3b82f6"
	},
	{
		name: "Códice Cotalker",
		description:
			"Buenas prácticas para implementadores: convenciones de nombres, variables de entorno, prefijos y las lecciones que la documentación oficial no cubre.",
		tagSlug: "codice-cotalker",
		color: "#ef4444"
	}
];

const recentPosts = await getRecentPosts(3);

const seriesSlug = seriesConfig.map(s => s.tagSlug);
const counts = await Promise.all(seriesSlug.map(getPostCountByTag));

const series = seriesConfig.map((serie, index) => ({
	...serie,
	posts: counts[index]
}));

const tagColorMap = Object.fromEntries(
	seriesConfig.map(serie => [serie.tagSlug, serie.color])
);

function getPostSeriesTag(post: GhostPost) {
	return post.tags?.find(t => tagColorMap[t.slug]);
}

function formatDate(dateStr: string): string {
	return new Date(dateStr).toLocaleDateString("es-CL", {
		day: "numeric",
		month: "short",
		year: "numeric"
	});
}
---

<section class="blog" id="blog">
	<div class="container">
		<h2 class="section-title">Blog</h2>
		<p class="section-description">
			Documento lo que aprendo en series temáticas. Cada serie agrupa
			artículos relacionados para que puedas seguir un hilo coherente.
		</p>

		<div class="recent-posts">
			<h3 class="subsection-title">Últimos artículos</h3>
			<div class="recent-grid">
				{
					recentPosts.map(post => {
						const seriesTag = getPostSeriesTag(post);
						const accentColor = seriesTag
							? tagColorMap[seriesTag.slug]
							: "var(--accent)";
						return (
							<a
								href={post.url}
								target="_blank"
								rel="noopener noreferrer"
								class="recent-card"
							>
								{post.feature_image && (
									<div class="recent-image">
										<img
											src={post.feature_image}
											alt={
												post.feature_image_alt ||
												post.title
											}
											loading="lazy"
										/>
									</div>
								)}
								<div class="recent-content">
									<div class="recent-meta">
										<time datetime={post.published_at}>
											{formatDate(post.published_at)}
										</time>
										{seriesTag && (
											<span
												class="recent-tag"
												style={`color: ${accentColor}`}
											>
												{seriesTag.name}
											</span>
										)}
									</div>
									<h4 class="recent-title">{post.title}</h4>
									<p class="recent-excerpt">{post.excerpt}</p>
								</div>
							</a>
						);
					})
				}
			</div>
			<div class="newsletter-cta">
				<p>Los suscriptores leen los artículos un día antes.</p>
				<a
					href="https://blog.etejeda.dev/#/portal/signup/free"
					target="_blank"
					rel="noopener noreferrer"
					class="newsletter-link"
				>
					Suscríbete al newsletter
					<ArrowRight size={14} />
				</a>
			</div>
		</div>

		<h3 class="subsection-title">Series</h3>
		<div class="series-grid">
			{
				series.map(serie => (
					<a
						href={`https://blog.etejeda.dev/tag/${serie.tagSlug}/`}
						target="_blank"
						rel="noopener noreferrer"
						class="series-card"
					>
						<div
							class="series-accent"
							style={`background: ${serie.color}`}
						/>
						<div class="series-content">
							<div class="series-header">
								<h3 class="series-name">{serie.name}</h3>
								<span class="series-count">
									{serie.posts}{" "}
									{serie.posts === 1
										? "artículo"
										: "artículos"}
								</span>
							</div>
							<p class="series-description">
								{serie.description}
							</p>
						</div>
					</a>
				))
			}
		</div>
		<div class="blog-cta">
			<a
				href="https://blog.etejeda.dev"
				target="_blank"
				rel="noopener noreferrer"
				class="btn btn-primary"
			>
				Explorar el blog
				<ArrowUpRight />
			</a>
		</div>
	</div>
</section>

<style>
	.blog {
		padding: 6rem 1.5rem;
		background: rgba(var(--overlay-rgb), 0.01);
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}

	.section-title::after {
		content: "";
		display: block;
		width: 48px;
		height: 3px;
		background: var(--accent);
		margin-top: 0.75rem;
		border-radius: 2px;
	}

	.section-description {
		color: var(--text-secondary);
		font-size: 1.05rem;
		margin-bottom: 2.5rem;
		margin-top: 1rem;
		max-width: 600px;
	}

	.subsection-title {
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
	}

	.recent-posts {
		margin-bottom: 3rem;
	}

	.recent-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.recent-card {
		background: rgba(var(--overlay-rgb), 0.02);
		border: 1px solid rgba(var(--overlay-rgb), 0.06);
		border-radius: 12px;
		overflow: hidden;
		transition: all 0.25s ease;
		text-decoration: none;
		display: block;
	}

	.recent-card:hover {
		border-color: rgba(var(--overlay-rgb), 0.12);
		transform: translateY(-2px);
	}

	.recent-image {
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}

	.recent-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.recent-card:hover .recent-image img {
		transform: scale(1.03);
	}

	.recent-content {
		padding: 1.25rem;
	}

	.recent-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.6rem;
	}

	.recent-meta time {
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	.recent-tag {
		font-size: 0.7rem;
		font-weight: 600;
	}

	.recent-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1.4;
		margin-bottom: 0.5rem;
	}

	.recent-excerpt {
		color: var(--text-secondary);
		font-size: 0.8rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.newsletter-cta {
		margin-top: 1.5rem;
		padding: 1.25rem 1.5rem;
		background: rgba(var(--accent-rgb), 0.06);
		border: 1px solid rgba(var(--accent-rgb), 0.15);
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.newsletter-cta p {
		color: var(--text-secondary);
		font-size: 0.9rem;
	}

	.newsletter-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--accent-light);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
	}

	.newsletter-link:hover {
		color: var(--accent);
	}

	.series-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.series-card {
		background: rgba(var(--overlay-rgb), 0.02);
		border: 1px solid rgba(var(--overlay-rgb), 0.06);
		border-radius: 12px;
		overflow: hidden;
		transition: all 0.25s ease;
		text-decoration: none;
		display: block;
	}

	.series-card:hover {
		border-color: rgba(var(--overlay-rgb), 0.12);
		transform: translateY(-2px);
	}

	.series-accent {
		height: 3px;
		width: 100%;
	}

	.series-content {
		padding: 1.5rem;
	}

	.series-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		margin-bottom: 0.75rem;
		gap: 0.5rem;
	}

	.series-name {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
	}

	.series-count {
		font-size: 0.7rem;
		color: var(--text-muted);
		background: rgba(var(--overlay-rgb), 0.05);
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.series-description {
		color: var(--text-secondary);
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.blog-cta {
		margin-top: 2.5rem;
		text-align: center;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-primary {
		background: var(--accent);
		color: var(--btn-on-accent);
	}

	.btn-primary:hover {
		background: var(--accent-hover);
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(var(--accent-rgb), 0.35);
	}

	@media (max-width: 768px) {
		.newsletter-cta {
			flex-direction: column;
			text-align: center;
		}

		.recent-grid {
			grid-template-columns: 1fr;
		}

		.series-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
