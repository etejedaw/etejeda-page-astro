---
import {
	getRecentPosts,
	getPostCountByTag,
	type GhostPost
} from "../providers/ghost";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

interface Serie {
	name: string;
	description: string;
	tagSlug: string;
	posts?: number;
	color: string;
}

const seriesConfig: Serie[] = [
	{
		name: "Integración Replicante",
		description:
			"Casos reales de integración con patrones de diseño aplicados a problemas reales.",
		tagSlug: "integracion-replicante",
		color: "#06b6d4"
	},
	{
		name: "Protocolo Lambda",
		description:
			"Serverless en producción: middlewares, auth, rate limiting y validación con Middy + Zod.",
		tagSlug: "protocolo-lambda",
		color: "#8b5cf6"
	},
	{
		name: "Pergaminos Rápidos",
		description:
			"Artículos directos al grano: problema, solución, código. Sin rodeos.",
		tagSlug: "pergaminos-rapidos",
		color: "#f59e0b"
	},
	{
		name: "Nexus de Integración",
		description:
			"Arquitectura de integraciones en Cotalker: bots, endpoints, conexiones entrantes y salientes.",
		tagSlug: "nexus-de-integracion",
		color: "#10b981"
	},
	{
		name: "Hechicería Cotlang",
		description:
			"La guía más completa de Cotlang: desde la sintaxis básica hasta funciones ocultas no documentadas.",
		tagSlug: "hechiceria-cotlang",
		color: "#3b82f6"
	},
	{
		name: "Códice Cotalker",
		description:
			"Buenas prácticas para implementadores y lecciones que la documentación oficial no cubre.",
		tagSlug: "codice-cotalker",
		color: "#ef4444"
	}
];

const recentPosts = await getRecentPosts(3);

const seriesSlug = seriesConfig.map(s => s.tagSlug);
const counts = await Promise.all(seriesSlug.map(getPostCountByTag));

const series = seriesConfig.map((serie, index) => ({
	...serie,
	posts: counts[index]
}));

const extraSeriesColors: Record<string, string> = {
	terraformando: "#84cc16",
	fundamentos: "#14b8a6"
};

const tagColorMap: Record<string, string> = {
	...Object.fromEntries(
		seriesConfig.map(serie => [serie.tagSlug, serie.color])
	),
	...extraSeriesColors
};

function getPostSeriesTag(post: GhostPost) {
	return post.tags?.find(t => tagColorMap[t.slug]);
}

function formatDate(dateStr: string): string {
	return new Date(dateStr).toLocaleDateString("es-CL", {
		day: "numeric",
		month: "short",
		year: "numeric"
	});
}
---

<section class="section" id="blog">
	<header class="section-header">
		<h2 class="section-title">Blog</h2>
	</header>

	<div class="block">
		<h3 class="block-title">Últimos artículos</h3>
		<ol class="posts">
			{
				recentPosts.map(post => {
					const seriesTag = getPostSeriesTag(post);
					const accentColor = seriesTag
						? tagColorMap[seriesTag.slug]
						: "var(--accent)";
					return (
						<li>
							<a
								href={post.url}
								target="_blank"
								rel="noopener noreferrer"
								class="post"
							>
								{post.feature_image ? (
									<div class="post-cover">
										<img
											src={post.feature_image}
											alt={
												post.feature_image_alt ||
												post.title
											}
											loading="lazy"
											decoding="async"
										/>
									</div>
								) : (
									<div
										class="post-cover post-cover-fallback"
										style={`background: linear-gradient(135deg, ${accentColor}, color-mix(in srgb, ${accentColor} 50%, var(--bg-surface)));`}
									>
										<span aria-hidden="true">¶</span>
									</div>
								)}
								<div class="post-body">
									<div class="post-meta">
										<time datetime={post.published_at}>
											{formatDate(post.published_at)}
										</time>
										{seriesTag && (
											<span
												class="post-series"
												style={`color: ${accentColor};`}
											>
												<span
													class="post-dot"
													style={`background: ${accentColor};`}
												/>
												{seriesTag.name}
											</span>
										)}
									</div>
									<h4 class="post-title">
										{post.title}
										<span
											class="post-arrow"
											aria-hidden="true"
										>
											<ArrowUpRight size={14} />
										</span>
									</h4>
									<p class="post-excerpt">{post.excerpt}</p>
								</div>
							</a>
						</li>
					);
				})
			}
		</ol>
		<a
			href="https://blog.etejeda.dev/#/portal/signup/free"
			target="_blank"
			rel="noopener noreferrer"
			class="newsletter"
		>
			<div class="newsletter-text">
				<span class="newsletter-eyebrow">Newsletter</span>
				<span class="newsletter-title">
					Recibe los nuevos posts en tu correo.
				</span>
			</div>
			<span class="newsletter-cta">
				Suscribirse
				<ArrowUpRight size={16} />
			</span>
		</a>
	</div>

	<div class="block">
		<h3 class="block-title">Series</h3>
		<ul class="series-list">
			{
				series.map(serie => (
					<li>
						<a
							href={`https://blog.etejeda.dev/tag/${serie.tagSlug}/`}
							target="_blank"
							rel="noopener noreferrer"
							class="series"
							style={`--s-color: ${serie.color};`}
						>
							<span class="series-mark" />
							<div class="series-body">
								<div class="series-header">
									<span class="series-name">
										{serie.name}
									</span>
									<span class="series-count">
										{serie.posts}{" "}
										{serie.posts === 1
											? "artículo"
											: "artículos"}
									</span>
								</div>
								<p class="series-description">
									{serie.description}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</div>

	<p class="cta">
		<a
			href="https://blog.etejeda.dev"
			target="_blank"
			rel="noopener noreferrer"
		>
			Explorar el blog completo
			<ArrowUpRight size={14} />
		</a>
	</p>
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.block {
		margin-bottom: 2.75rem;
	}

	.block-title {
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-bottom: 1rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--rule);
	}

	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.post {
		display: grid;
		grid-template-columns: 160px 1fr;
		gap: 1.25rem;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 12px;
		overflow: hidden;
		text-decoration: none;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.post:hover,
	.post:focus-visible {
		border-color: var(--accent-border);
		transform: translateY(-2px);
		box-shadow: 0 12px 32px -16px rgba(0, 0, 0, 0.35);
	}

	.post:hover .post-title,
	.post:focus-visible .post-title {
		color: var(--accent);
	}

	.post:hover .post-arrow,
	.post:focus-visible .post-arrow {
		transform: translate(2px, -2px);
		color: var(--accent);
	}

	.post:hover .post-cover img,
	.post:focus-visible .post-cover img {
		transform: scale(1.04);
	}

	.post-cover {
		aspect-ratio: 1;
		overflow: hidden;
		background: var(--bg-elevated);
	}

	.post-cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.post-cover-fallback {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 3rem;
		font-weight: 800;
		color: rgba(255, 255, 255, 0.85);
	}

	.post-body {
		padding: 1.1rem 1.25rem 1.1rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.post-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		font-size: 0.72rem;
	}

	.post-meta time {
		font-family: var(--font-jetbrains-mono), monospace;
		color: var(--text-muted);
	}

	.post-series {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.post-dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
	}

	.post-title {
		font-size: 1rem;
		font-weight: 700;
		color: var(--text-primary);
		line-height: 1.3;
		letter-spacing: -0.01em;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.post-arrow {
		display: inline-flex;
		color: var(--text-muted);
		transition:
			transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.post-excerpt {
		color: var(--text-secondary);
		font-size: 0.88rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.newsletter {
		margin-top: 1.5rem;
		padding: 1.1rem 1.35rem;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1rem;
		align-items: center;
		text-decoration: none;
		background:
			radial-gradient(
				circle at 90% 0%,
				var(--accent-soft) 0%,
				transparent 55%
			),
			var(--bg-surface);
		border: 1px solid var(--accent-border);
		border-radius: 12px;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.newsletter:hover {
		transform: translateY(-2px);
		box-shadow: 0 14px 32px -18px rgba(var(--accent-rgb), 0.4);
		border-color: var(--accent);
	}

	.newsletter-text {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.newsletter-eyebrow {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--accent);
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.newsletter-title {
		color: var(--text-primary);
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.35;
		letter-spacing: -0.01em;
	}

	.newsletter-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-inter), sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--btn-on-accent);
		background: var(--accent);
		padding: 0.55rem 0.95rem;
		border-radius: 8px;
		white-space: nowrap;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}

	.newsletter:hover .newsletter-cta {
		background: var(--accent-hover);
	}

	.newsletter:hover .newsletter-cta svg {
		transform: translate(2px, -2px);
	}

	.newsletter-cta svg {
		transition: transform 0.2s ease;
	}

	.series-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-auto-rows: 1fr;
		gap: 0.85rem;
	}

	.series-list li {
		display: flex;
	}

	.series {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.85rem;
		padding: 1rem 1.1rem;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 10px;
		text-decoration: none;
		align-items: start;
		width: 100%;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.series:hover,
	.series:focus-visible {
		border-color: var(--s-color);
		transform: translateY(-2px);
		box-shadow: 0 10px 24px -16px
			color-mix(in srgb, var(--s-color) 50%, transparent);
	}

	.series-mark {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		display: block;
		margin-top: 0.35rem;
		background: var(--s-color);
		box-shadow: 0 0 12px color-mix(in srgb, var(--s-color) 50%, transparent);
	}

	.series-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.6rem;
		margin-bottom: 0.3rem;
	}

	.series-name {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.series-count {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.7rem;
		color: var(--text-muted);
		white-space: nowrap;
	}

	.series-description {
		color: var(--text-secondary);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.cta {
		margin-top: 1.5rem;
		font-size: 0.95rem;
	}

	.cta a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 600;
		padding-bottom: 2px;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 100% 1.5px;
		transition:
			color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			background-size 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.cta a:hover {
		color: var(--accent);
		background-size: 100% 3px;
	}

	@media (max-width: 700px) {
		.newsletter {
			grid-template-columns: 1fr;
			gap: 0.85rem;
		}

		.newsletter-cta {
			justify-self: start;
		}

		.post {
			grid-template-columns: 1fr;
		}

		.post-cover {
			aspect-ratio: 16 / 9;
		}

		.post-body {
			padding: 0.5rem 1.25rem 1.25rem;
		}

		.series-list {
			grid-template-columns: 1fr;
		}

		.series-header {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.1rem;
		}
	}
</style>
