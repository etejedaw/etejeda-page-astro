---

---

<section class="hero">
	<div class="hero-content">
		<div class="hero-badge">Senior Project Engineer</div>
		<h1 class="hero-title">
			Hola, soy <span class="highlight">Esteban Tejeda</span>
		</h1>
		<p class="hero-subtitle">
			Integro plataformas SaaS, CRMs y sistemas enterprise. Cada vez que
			sobrevivo a un proyecto, lo documento en mi blog técnico para que
			el próximo no empiece de cero.
		</p>
		<div class="hero-cta">
			<a href="#proyectos" class="btn btn-primary">
				Conoce mi trabajo
				<svg
					width="16"
					height="16"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="M12 5v14M5 12l7 7 7-7"></path>
				</svg>
			</a>
			<a href="#contacto" class="btn btn-secondary">Contáctame</a>
		</div>
		<div class="hero-terminal">
			<div class="terminal-bar">
				<span class="terminal-dot red"></span>
				<span class="terminal-dot yellow"></span>
				<span class="terminal-dot green"></span>
				<span class="terminal-title">~/.dev</span>
			</div>
			<div class="terminal-body">
				<code>
					<span class="prompt">$</span>
					<span class="cmd">whoami</span><br />
					<span class="output"
						>Un dev que sobrevive a sus propios errores</span
					><br />
					<span class="prompt">$</span>
					<span class="cmd">cat daily.log</span><br />
					<span class="output"
						>09:00 Espresso doble. Sin esto no arranca el día.</span
					><br />
					<span class="output"
						>11:00 Diseñando la integración entre el cliente y su
						ERP</span
					><br />
					<span class="output"
						>17:59 git push origin main --force y que el universo
						decida</span
					><br />
					<span class="output"
						>22:00 Escribiendo el post que me hubiera salvado ayer</span
					><br />
					<span class="prompt">$</span>
					<span class="cursor">_</span>
				</code>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8rem 1.5rem 4rem;
		position: relative;
		overflow: hidden;
	}

	.hero::before {
		content: "";
		position: absolute;
		top: -50%;
		left: -50%;
		width: 200%;
		height: 200%;
		background:
			radial-gradient(
				ellipse at 30% 20%,
				rgba(var(--accent-rgb), 0.08) 0%,
				transparent 50%
			),
			radial-gradient(
				ellipse at 70% 80%,
				rgba(var(--accent-blue-rgb), 0.05) 0%,
				transparent 50%
			);
		pointer-events: none;
	}

	.hero-content {
		max-width: 750px;
		position: relative;
		z-index: 1;
	}

	.hero-badge {
		display: inline-block;
		padding: 0.35rem 1rem;
		background: rgba(var(--accent-rgb), 0.1);
		border: 1px solid rgba(var(--accent-rgb), 0.25);
		border-radius: 100px;
		color: var(--accent-light);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		margin-bottom: 1.5rem;
	}

	.hero-title {
		font-size: clamp(2.2rem, 5vw, 3.5rem);
		font-weight: 800;
		line-height: 1.15;
		color: var(--text-primary);
		margin-bottom: 1.25rem;
		letter-spacing: -0.03em;
	}

	.highlight {
		background: linear-gradient(135deg, var(--accent), var(--accent-blue));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-subtitle {
		font-size: 1.15rem;
		line-height: 1.75;
		color: var(--text-secondary);
		margin-bottom: 2rem;
		max-width: 600px;
	}

	.hero-subtitle strong {
		color: var(--text-primary);
		font-weight: 600;
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		margin-bottom: 3rem;
		flex-wrap: wrap;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-primary {
		background: var(--accent);
		color: var(--btn-on-accent);
	}

	.btn-primary:hover {
		background: var(--accent-hover);
		transform: translateY(-1px);
		box-shadow: 0 4px 20px rgba(var(--accent-rgb), 0.35);
	}

	.btn-secondary {
		background: transparent;
		color: var(--text-secondary);
		border: 1px solid rgba(var(--overlay-rgb), 0.12);
	}

	.btn-secondary:hover {
		color: var(--text-primary);
		border-color: rgba(var(--overlay-rgb), 0.25);
	}

	.hero-terminal {
		background: var(--terminal-bg);
		border: 1px solid rgba(var(--overlay-rgb), 0.08);
		border-radius: 12px;
		overflow: hidden;
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-size: 0.85rem;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
	}

	.terminal-bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		background: rgba(var(--overlay-rgb), 0.03);
		border-bottom: 1px solid rgba(var(--overlay-rgb), 0.06);
	}

	.terminal-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
	}

	.terminal-dot.red {
		background: #ff5f57;
	}
	.terminal-dot.yellow {
		background: #febc2e;
	}
	.terminal-dot.green {
		background: #28c840;
	}

	.terminal-title {
		margin-left: 0.5rem;
		color: var(--text-muted);
		font-size: 0.75rem;
	}

	.terminal-body {
		padding: 1.25rem;
		line-height: 1.8;
	}

	.prompt {
		color: var(--accent);
	}
	.cmd {
		color: var(--accent-light);
	}
	.output {
		color: var(--text-secondary);
	}

	.cursor {
		animation: blink 1s step-end infinite;
		color: var(--accent);
	}

	@keyframes blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0;
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 7rem 1.25rem 3rem;
		}

		.hero-terminal {
			font-size: 0.75rem;
		}
	}
</style>
