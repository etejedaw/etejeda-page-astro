---
import Sun from "./icons/Sun.astro";
import Moon from "./icons/Moon.astro";
import GitHub from "./icons/GitHub.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Mail from "./icons/Mail.astro";
import Book from "./icons/Book.astro";

interface NavLink {
	href: string;
	label: string;
	id: string;
}

const navLinks: NavLink[] = [
	{ href: "#sobre-mi", label: "Sobre mí", id: "sobre-mi" },
	{ href: "#experiencia", label: "Experiencia", id: "experiencia" },
	{ href: "#expertise", label: "Expertise", id: "expertise" },
	{ href: "#projects", label: "Proyectos", id: "projects" },
	{ href: "#blog", label: "Blog", id: "blog" },
	{ href: "#contacto", label: "Contacto", id: "contacto" }
];
---

<section class="hero">
	<div class="hero-top">
		<div class="mark" aria-hidden="true">
			<span class="lambda">λ</span>
		</div>

		<h1 class="name">Esteban Tejeda</h1>
		<p class="role">Technical Architect</p>

		<ul class="specs" aria-label="Áreas">
			<li>Integraciones</li>
			<li>Serverless</li>
			<li>Backend</li>
			<li>SaaS</li>
		</ul>

		<p class="location">
			<span class="dot"></span>
			Santiago, Chile
		</p>

		<nav class="side-nav" aria-label="Secciones">
			<ul>
				{
					navLinks.map(link => (
						<li>
							<a href={link.href} data-section={link.id}>
								<span class="nav-line" />
								<span class="nav-label">{link.label}</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>

	<div class="hero-bottom">
		<div class="hero-actions">
			<ul class="socials" aria-label="Redes sociales">
				<li>
					<a href="mailto:contacto@etejeda.dev" aria-label="Email">
						<Mail size={20} />
					</a>
				</li>
				<li>
					<a
						href="https://github.com/etejedaw"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
					>
						<GitHub size={20} />
					</a>
				</li>
				<li>
					<a
						href="https://www.linkedin.com/in/etejedaw/"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="LinkedIn"
					>
						<LinkedIn size={20} />
					</a>
				</li>
				<li>
					<a
						href="https://blog.etejeda.dev"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Blog"
					>
						<Book size={20} />
					</a>
				</li>
			</ul>
			<button
				class="theme-toggle"
				aria-label="Cambiar tema"
				type="button"
			>
				<Sun class="icon-sun" />
				<Moon class="icon-moon" />
			</button>
		</div>
	</div>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		position: relative;
	}

	.theme-toggle {
		background: none;
		border: 1px solid var(--rule-strong);
		border-radius: 6px;
		padding: 0.35rem;
		cursor: pointer;
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
		flex-shrink: 0;
	}

	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent-border);
	}

	:global(.icon-sun) {
		display: block;
	}
	:global(.icon-moon) {
		display: none;
	}
	:global([data-theme="dark"] .icon-sun) {
		display: none;
	}
	:global([data-theme="dark"] .icon-moon) {
		display: block;
	}

	.mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1.5rem;
		line-height: 1;
		animation: drift 18s ease-in-out infinite;
		transform-origin: center center;
		will-change: transform;
	}

	.lambda {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 4rem;
		font-weight: 400;
		line-height: 0.85;
		color: var(--accent);
		letter-spacing: -0.02em;
		text-shadow: 0 0 24px rgba(var(--accent-rgb), 0.25);
	}

	@keyframes drift {
		0%,
		100% {
			transform: translate(0, 0);
		}
		25% {
			transform: translate(40px, -20px);
		}
		50% {
			transform: translate(80px, 10px);
		}
		75% {
			transform: translate(30px, 30px);
		}
	}

	.name {
		font-size: clamp(2.25rem, 5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1;
		color: var(--text-primary);
		margin-bottom: 0.6rem;
	}

	.role {
		font-size: 1rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 1.25rem;
		letter-spacing: 0.01em;
	}

	.specs {
		list-style: none;
		padding: 0;
		margin: 0 0 1.25rem;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.specs li {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		line-height: 1;
	}

	.location {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.78rem;
		color: var(--text-secondary);
		margin-bottom: 2.25rem;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		line-height: 1.4;
	}

	.dot {
		display: inline-block;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		flex-shrink: 0;
		box-shadow: 0 0 0 0 var(--accent);
		animation: pulse 2.5s ease-in-out infinite;
	}

	@keyframes pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.4);
		}
		50% {
			box-shadow: 0 0 0 5px rgba(var(--accent-rgb), 0);
		}
	}

	.side-nav {
		display: none;
	}

	.side-nav ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.side-nav a {
		display: inline-flex;
		align-items: center;
		gap: 1rem;
		padding: 0.55rem 0;
		text-decoration: none;
		color: var(--text-muted);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		transition: color 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.nav-line {
		display: inline-block;
		width: 28px;
		height: 1px;
		background: var(--text-muted);
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.side-nav a:hover,
	.side-nav a:focus-visible,
	.side-nav a.is-active {
		color: var(--text-primary);
	}

	.side-nav a:hover .nav-line,
	.side-nav a:focus-visible .nav-line,
	.side-nav a.is-active .nav-line {
		width: 56px;
		background: var(--accent);
	}

	.hero-bottom {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--rule);
	}

	.socials {
		display: flex;
		gap: 1.25rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.socials a {
		color: var(--text-secondary);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition:
			color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.socials a:hover {
		color: var(--accent);
		transform: translateY(-3px);
	}

	@media (min-width: 1024px) {
		.hero {
			padding-right: 1rem;
			justify-content: space-between;
			min-height: 100%;
			gap: 3rem;
		}

		.name {
			font-size: clamp(3rem, 5.5vw, 4rem);
		}

		.side-nav {
			display: block;
			margin-bottom: 3rem;
		}
	}

	@media (max-width: 1023px) {
		.mark {
			display: none;
		}

		.hero-bottom {
			display: none;
		}

		.location {
			margin-bottom: 0.5rem;
		}
	}
</style>

<script>
	if (typeof window !== "undefined" && "IntersectionObserver" in window) {
		const sections =
			document.querySelectorAll<HTMLElement>("main section[id]");
		const navLinks = document.querySelectorAll<HTMLAnchorElement>(
			".side-nav a[data-section]"
		);

		if (sections.length && navLinks.length) {
			const setActive = (id: string) => {
				navLinks.forEach(link => {
					link.classList.toggle(
						"is-active",
						link.dataset.section === id
					);
				});
			};

			const observer = new IntersectionObserver(
				entries => {
					const visible = entries
						.filter(e => e.isIntersecting)
						.sort(
							(a, b) => b.intersectionRatio - a.intersectionRatio
						)[0];
					if (visible) setActive(visible.target.id);
				},
				{
					rootMargin: "-30% 0px -50% 0px",
					threshold: [0, 0.1, 0.25, 0.5]
				}
			);

			sections.forEach(section => observer.observe(section));
		}
	}
</script>
