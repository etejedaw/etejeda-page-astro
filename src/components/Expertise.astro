---
import Zap from "./icons/Zap.astro";
import Link from "./icons/Link.astro";
import Server from "./icons/Server.astro";
import Cpu from "./icons/Cpu.astro";

type IconName = "zap" | "link" | "server" | "cpu";

interface Skill {
	title: string;
	description: string;
	tags: string[];
	icon: IconName;
}

const iconMap = {
	zap: Zap,
	link: Link,
	server: Server,
	cpu: Cpu
};

const skills: Skill[] = [
	{
		title: "Backend & Serverless",
		description:
			"Diseño e implementación de backend con principios SOLID y patrones de diseño aplicados a problemas reales. Arquitecturas serverless en producción con manejo centralizado de errores.",
		tags: [
			"Node.js",
			"TypeScript",
			"AWS Lambda",
			"Middy",
			"Zod",
			"Express"
		],
		icon: "zap"
	},
	{
		title: "Integraciones & Automatización",
		description:
			"Conexión entre plataformas y sistemas externos: transformación de datos, mappers y serializers, y automatización de procesos sobre plataformas de workflow automation como Cotalker.",
		tags: [
			"APIs REST",
			"Webhooks",
			"ETL",
			"SAP",
			"Snowflake",
			"Workflow Automation",
			"Data Modeling"
		],
		icon: "link"
	},
	{
		title: "Infraestructura & CI/CD",
		description:
			"Servidores GNU/Linux, contenedores, CI/CD y bases de datos. Lo suficiente para montar, desplegar y mantener lo que construyo sin depender de otro equipo.",
		tags: ["GNU/Linux", "Docker", "CapRover", "PostgreSQL", "MySQL"],
		icon: "server"
	},
	{
		title: "Ingeniería asistida por IA",
		description:
			"Programé a mano durante años, y eso es lo que hoy me permite saber cuándo la IA se equivoca. Trabajo con agentes como parte del flujo: diseño el contexto y las skills que los guían, reviso lo que producen y decido qué llega a producción.",
		tags: [
			"Claude Code",
			"Agentes",
			"Skills",
			"Context Engineering",
			"Code Review"
		],
		icon: "cpu"
	}
];
---

<section class="section" id="expertise">
	<header class="section-header">
		<h2 class="section-title">Expertise</h2>
	</header>

	<div class="skills">
		{
			skills.map(skill => {
				const Icon = iconMap[skill.icon];
				return (
					<article class="skill">
						<div class="skill-icon" aria-hidden="true">
							<Icon size={24} />
						</div>
						<div class="skill-content">
							<h3 class="skill-title">{skill.title}</h3>
							<p class="skill-description">{skill.description}</p>
							<ul class="skill-tags">
								{skill.tags.map(tag => (
									<li>{tag}</li>
								))}
							</ul>
						</div>
					</article>
				);
			})
		}
	</div>
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.skill {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: 1.25rem;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 12px;
		padding: 1.5rem 1.75rem;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		align-items: start;
	}

	.skill:hover {
		background: var(--bg-elevated);
		border-color: var(--accent-border);
		transform: translateY(-2px);
	}

	.skill-icon {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
		background: var(--accent-soft);
		border-radius: 10px;
	}

	.skill-content {
		min-width: 0;
	}

	.skill-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.55rem;
		letter-spacing: -0.015em;
	}

	.skill-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.skill-tags li {
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.27rem 0.65rem;
		border-radius: 999px;
		line-height: 1;
	}

	@media (max-width: 600px) {
		.skill {
			grid-template-columns: 48px 1fr;
			gap: 1rem;
			padding: 1.25rem 1.25rem;
		}

		.skill-icon {
			width: 48px;
			height: 48px;
		}
	}
</style>
