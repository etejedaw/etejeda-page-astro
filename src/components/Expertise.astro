---
interface Skill {
	title: string;
	description: string;
	tags: string[];
	icon: string;
}

const skills: Skill[] = [
	{
		title: "Backend & Serverless",
		description:
			"Desarrollo backend con principios SOLID y patrones de diseño aplicados a problemas reales. Arquitecturas serverless en producción con manejo centralizado de errores.",
		tags: [
			"Node.js",
			"TypeScript",
			"AWS Lambda",
			"Middy",
			"Zod",
			"Express"
		],
		icon: "&#9889;"
	},
	{
		title: "Integraciones & Automatización",
		description:
			"Conexión entre plataformas y sistemas externos. Transformación de datos, mappers y serializers para hacer hablar a formatos que no fueron diseñados para entenderse.",
		tags: ["APIs REST", "Webhooks", "ETL", "SAP", "Snowflake", "CRMs"],
		icon: "&#128279;"
	},
	{
		title: "Infraestructura & CI/CD",
		description:
			"Servidores Linux, contenedores, CI/CD y bases de datos. Lo suficiente para montar, desplegar y mantener lo que construyo sin depender de otro equipo.",
		tags: ["Linux", "Docker", "CapRover", "PostgreSQL", "MySQL"],
		icon: "&#9881;"
	},
	{
		title: "Workflow Automation & SaaS",
		description:
			"Diseñé la arquitectura de integraciones para clientes enterprise, mentoricé partners y traduje necesidades de negocio en soluciones técnicas sobre plataformas de workflow automation como Cotalker.",
		tags: ["Workflow Automation", "Cotalker", "Cotlang", "Data Modeling"],
		icon: "&#128736;"
	},
	{
		title: "Producto end to end",
		description:
			"Funcionalidades completas sobre producto en producción: del modelo de datos y la API hasta la interfaz en React, en flujos financieros donde los números tienen que cuadrar.",
		tags: ["React", "TypeScript", "DynamoDB", "REST"],
		icon: "&#129513;"
	}
];
---

<section class="section" id="expertise">
	<header class="section-header">
		<h2 class="section-title">Expertise</h2>
	</header>

	<div class="skills">
		{
			skills.map(skill => (
				<article class="skill">
					<div
						class="skill-icon"
						aria-hidden="true"
						set:html={skill.icon}
					/>
					<div class="skill-content">
						<h3 class="skill-title">{skill.title}</h3>
						<p class="skill-description">{skill.description}</p>
						<ul class="skill-tags">
							{skill.tags.map(tag => (
								<li>{tag}</li>
							))}
						</ul>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.skills {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.skill {
		display: grid;
		grid-template-columns: 56px 1fr;
		gap: 1.25rem;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 12px;
		padding: 1.5rem 1.75rem;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		align-items: start;
	}

	.skill:hover {
		background: var(--bg-elevated);
		border-color: var(--accent-border);
		transform: translateY(-2px);
	}

	.skill-icon {
		width: 56px;
		height: 56px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.6rem;
		line-height: 1;
		background: var(--accent-soft);
		border-radius: 10px;
		filter: saturate(1.1);
	}

	.skill-content {
		min-width: 0;
	}

	.skill-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.55rem;
		letter-spacing: -0.015em;
	}

	.skill-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
		margin-bottom: 1rem;
	}

	.skill-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.skill-tags li {
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.27rem 0.65rem;
		border-radius: 999px;
		line-height: 1;
	}

	@media (max-width: 600px) {
		.skill {
			grid-template-columns: 48px 1fr;
			gap: 1rem;
			padding: 1.25rem 1.25rem;
		}

		.skill-icon {
			width: 48px;
			height: 48px;
			font-size: 1.4rem;
		}
	}
</style>
