---
import ArrowUpRight from "./icons/ArrowUpRight.astro";
---

<footer class="footer">
	<aside class="bridge">
		<p class="bridge-eyebrow">¿Servicios para pymes?</p>
		<a
			href="https://www.estebantejeda.com"
			target="_blank"
			rel="noopener noreferrer"
			class="bridge-link"
		>
			Encuéntrame en <strong>estebantejeda.com</strong>
			<ArrowUpRight size={14} />
		</a>
	</aside>
</footer>

<style>
	.footer {
		padding-top: 2.25rem;
		margin-top: 1.5rem;
		border-top: 1px solid var(--rule);
	}

	.bridge {
		border-left: 2px solid var(--accent);
		padding: 0.15rem 0 0.15rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.bridge-eyebrow {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--text-muted);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.bridge-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.95rem;
		color: var(--text-secondary);
		text-decoration: none;
		font-weight: 500;
		width: fit-content;
		transition: color 0.2s ease;
	}

	.bridge-link strong {
		color: var(--text-primary);
		font-weight: 700;
		background-image: linear-gradient(var(--accent), var(--accent));
		background-position: 0 100%;
		background-repeat: no-repeat;
		background-size: 100% 1.5px;
		padding-bottom: 1px;
		transition: background-size 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.bridge-link:hover {
		color: var(--text-primary);
	}

	.bridge-link:hover strong {
		background-size: 100% 3px;
		color: var(--accent);
	}

	.bridge-link svg {
		color: var(--text-muted);
		transition:
			color 0.25s cubic-bezier(0.4, 0, 0.2, 1),
			transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.bridge-link:hover svg {
		color: var(--accent);
		transform: translate(2px, -2px);
	}
</style>
