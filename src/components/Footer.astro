---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
	<div class="container">
		<div class="footer-content">
			<span class="footer-brand">
				<span class="bracket">{"{ "}</span>etejeda<span class="bracket">
					{"};"}</span
				>
			</span>
			<div class="footer-links">
				<a href="mailto:etejedaw@hotmail.com">Email</a>
				<a
					href="https://www.linkedin.com/in/etejedaw/"
					target="_blank"
					rel="noopener noreferrer">LinkedIn</a
				>
				<a
					href="https://github.com/etejedaw"
					target="_blank"
					rel="noopener noreferrer">GitHub</a
				>
			</div>
			<span class="footer-copy">&copy; {currentYear} Esteban Tejeda</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		padding: 2rem 1.5rem;
		border-top: 1px solid rgba(var(--overlay-rgb), 0.06);
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.footer-brand {
		font-family: "JetBrains Mono", "Fira Code", monospace;
		font-weight: 700;
		color: var(--text-secondary);
		font-size: 0.95rem;
	}

	.bracket {
		color: var(--accent);
	}

	.footer-links {
		display: flex;
		gap: 1.5rem;
	}

	.footer-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.85rem;
		transition: color 0.2s ease;
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	.footer-copy {
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	@media (max-width: 768px) {
		.footer-content {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}
	}
</style>
