---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <span class="footer-brand">
        <span class="bracket">&lt;</span>etejeda<span class="bracket"> /&gt;</span>
      </span>
      <span class="footer-copy">&copy; {currentYear} Esteban Tejeda</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-brand {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-weight: 700;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .bracket {
    color: var(--accent);
  }

  .footer-copy {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
