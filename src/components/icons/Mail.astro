---
interface Props {
	size?: number;
	class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
	width={size}
	height={size}
	class={className}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
>
	<rect x="2" y="4" width="20" height="16" rx="2"></rect>
	<path d="M22 4L12 13 2 4"></path>
</svg>
