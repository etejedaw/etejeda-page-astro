---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import ShowMore from "./ShowMore.astro";
import { byYearDesc } from "../lib/projects";

const all = await getCollection("projects", ({ data }) => !data.draft);
const projects = all
	.map(p => ({ ...p.data, slug: p.id.replace(/\.md$/, "") }))
	.sort(byYearDesc);

const initialCount = 3;
const initial = projects.slice(0, initialCount);
const extra = projects.slice(initialCount);
---

<section class="section" id="projects">
	<header class="section-header">
		<h2 class="section-title">Proyectos</h2>
	</header>

	<p class="section-note">
		Las integraciones para clientes enterprise no son públicas. Acá van los
		proyectos propios, freelance y de investigación.
	</p>

	<div class="projects">
		{initial.map(project => <ProjectCard project={project} />)}

		<div class="extra" id="extra-projects" data-extra="projects" hidden>
			{extra.map(project => <ProjectCard project={project} />)}
		</div>
	</div>

	{
		extra.length > 0 && (
			<ShowMore
				controls="extra-projects"
				target="projects"
				labelShow={`Ver ${extra.length} proyecto${extra.length === 1 ? "" : "s"} más`}
				labelHide="Ocultar proyectos"
			/>
		)
	}
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.section-note {
		color: var(--text-muted);
		font-size: 0.85rem;
		line-height: 1.6;
		max-width: 60ch;
		margin-bottom: 1.75rem;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.extra {
		display: contents;
	}

	.extra[hidden] {
		display: none;
	}
</style>
