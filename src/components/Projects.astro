---
import { getCollection } from "astro:content";
import GitHub from "./icons/GitHub.astro";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

const all = await getCollection("projects", ({ data }) => !data.draft);
const projects = all
	.map(p => ({ ...p.data, slug: p.id.replace(/\.md$/, "") }))
	.sort((a, b) => a.order - b.order);

const initialCount = 4;
const initial = projects.slice(0, initialCount);
const extra = projects.slice(initialCount);
---

<section class="section" id="proyectos">
	<header class="section-header">
		<h2 class="section-title">Proyectos</h2>
	</header>

	<div class="projects">
		{
			initial.map(project => (
				<article class="project" style={`--p-color: ${project.color};`}>
					<a
						href={`/proyectos/${project.slug}`}
						class="project-side"
						aria-label={`Ver detalle de ${project.title}`}
					>
						<div
							class:list={[
								"project-cover",
								project.image && "has-image"
							]}
							aria-hidden="true"
						>
							{project.image ? (
								<img
									src={project.image}
									alt=""
									class="project-image"
									loading="lazy"
									decoding="async"
								/>
							) : (
								<span class="project-mono">
									{project.short}
								</span>
							)}
							{project.year && (
								<span class="project-year-cover">
									{project.year}
								</span>
							)}
							<span class="project-cat">{project.category}</span>
						</div>
						<ul class="project-tags">
							{project.tags.map(tag => (
								<li>{tag}</li>
							))}
						</ul>
					</a>
					<div class="project-body">
						<div class="project-titlebar">
							<h3 class="project-title">
								<a href={`/proyectos/${project.slug}`}>
									{project.title}
								</a>
							</h3>
							<div class="project-links">
								{project.github && (
									<a
										href={project.github}
										target="_blank"
										rel="noopener noreferrer"
										class="project-link"
										aria-label={`GitHub de ${project.title}`}
									>
										<GitHub size={16} />
									</a>
								)}
								{project.url && (
									<a
										href={project.url}
										target="_blank"
										rel="noopener noreferrer"
										class="project-link"
										aria-label={`${project.title} en vivo`}
									>
										<ArrowUpRight size={16} />
									</a>
								)}
							</div>
						</div>
						<p class="project-description">{project.description}</p>
						<a
							href={`/proyectos/${project.slug}`}
							class="project-more"
						>
							Ver detalle <span aria-hidden="true">→</span>
						</a>
					</div>
				</article>
			))
		}

		<div class="extra" id="extra-projects" hidden>
			{
				extra.map(project => (
					<article
						class="project"
						style={`--p-color: ${project.color};`}
					>
						<a
							href={`/proyectos/${project.slug}`}
							class="project-side"
							aria-label={`Ver detalle de ${project.title}`}
						>
							<div
								class:list={[
									"project-cover",
									project.image && "has-image"
								]}
								aria-hidden="true"
							>
								{project.image ? (
									<img
										src={project.image}
										alt=""
										class="project-image"
										loading="lazy"
										decoding="async"
									/>
								) : (
									<span class="project-mono">
										{project.short}
									</span>
								)}
								{project.year && (
									<span class="project-year-cover">
										{project.year}
									</span>
								)}
								<span class="project-cat">
									{project.category}
								</span>
							</div>
							<ul class="project-tags">
								{project.tags.map(tag => (
									<li>{tag}</li>
								))}
							</ul>
						</a>
						<div class="project-body">
							<div class="project-titlebar">
								<h3 class="project-title">
									<a href={`/proyectos/${project.slug}`}>
										{project.title}
									</a>
								</h3>
								<div class="project-links">
									{project.github && (
										<a
											href={project.github}
											target="_blank"
											rel="noopener noreferrer"
											class="project-link"
											aria-label={`GitHub de ${project.title}`}
										>
											<GitHub size={16} />
										</a>
									)}
									{project.url && (
										<a
											href={project.url}
											target="_blank"
											rel="noopener noreferrer"
											class="project-link"
											aria-label={`${project.title} en vivo`}
										>
											<ArrowUpRight size={16} />
										</a>
									)}
								</div>
							</div>
							<p class="project-description">
								{project.description}
							</p>
							<a
								href={`/proyectos/${project.slug}`}
								class="project-more"
							>
								Ver detalle <span aria-hidden="true">→</span>
							</a>
						</div>
					</article>
				))
			}
		</div>
	</div>

	{
		extra.length > 0 && (
			<button
				type="button"
				class="show-more"
				aria-expanded="false"
				aria-controls="extra-projects"
			>
				<span class="show-more-label">
					Ver {extra.length} proyecto
					{extra.length === 1 ? "" : "s"} más
				</span>
				<span class="show-more-icon" aria-hidden="true">
					↓
				</span>
			</button>
		)
	}
</section>

<script>
	const btn = document.querySelector<HTMLButtonElement>(".show-more");
	const extra = document.getElementById("extra-projects");

	btn?.addEventListener("click", () => {
		const expanded = btn.getAttribute("aria-expanded") === "true";
		btn.setAttribute("aria-expanded", String(!expanded));
		if (expanded) {
			extra?.setAttribute("hidden", "");
			btn.querySelector(".show-more-label")!.textContent =
				btn.dataset.labelShow || "Ver más proyectos";
		} else {
			extra?.removeAttribute("hidden");
			btn.dataset.labelShow =
				btn.querySelector(".show-more-label")?.textContent || "";
			btn.querySelector(".show-more-label")!.textContent =
				"Ocultar proyectos";
		}
	});
</script>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.extra {
		display: contents;
	}

	.extra[hidden] {
		display: none;
	}

	.show-more {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 100%;
		margin-top: 1.5rem;
		padding: 0.95rem 1.25rem;
		background: transparent;
		border: 1px dashed var(--rule-strong);
		border-radius: 12px;
		color: var(--text-secondary);
		font-family: var(--font-inter), sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.show-more:hover,
	.show-more:focus-visible {
		color: var(--accent);
		border-color: var(--accent-border);
		background: var(--accent-soft);
	}

	.show-more-icon {
		font-family: var(--font-jetbrains-mono), monospace;
		transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.show-more[aria-expanded="true"] .show-more-icon {
		transform: rotate(180deg);
	}

	.project {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 0;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 14px;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.project:hover {
		border-color: var(--accent-border);
		transform: translateY(-3px);
		box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.4);
	}

	.project-side {
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--rule);
		text-decoration: none;
		color: inherit;
	}

	.project-cover {
		position: relative;
		background:
			radial-gradient(
				circle at 30% 20%,
				color-mix(in srgb, var(--p-color) 60%, transparent) 0%,
				transparent 65%
			),
			linear-gradient(
				160deg,
				color-mix(in srgb, var(--p-color) 38%, var(--bg-surface)),
				color-mix(in srgb, var(--p-color) 14%, var(--bg-surface))
			);
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: 0.9rem 1rem;
		min-height: 150px;
		overflow: hidden;
		border-bottom: 1px solid var(--rule);
	}

	.project-cover.has-image {
		background: #0a0a0a;
		padding: 0;
		min-height: 170px;
	}

	.project-image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top left;
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.project:hover .project-image {
		transform: scale(1.04);
	}

	.project-cover.has-image::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.55) 0%,
			rgba(0, 0, 0, 0) 35%,
			rgba(0, 0, 0, 0) 60%,
			rgba(0, 0, 0, 0.65) 100%
		);
		pointer-events: none;
		z-index: 1;
	}

	.project-cover.has-image .project-year-cover,
	.project-cover.has-image .project-cat {
		position: absolute;
		z-index: 2;
		color: #fff;
		opacity: 1;
		text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
	}

	.project-cover.has-image .project-year-cover {
		top: 0.85rem;
		right: 0.95rem;
	}

	.project-cover.has-image .project-cat {
		bottom: 0.85rem;
		left: 0.95rem;
	}

	.project-cover::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			rgba(255, 255, 255, 0.05) 1px,
			transparent 1px
		);
		background-size: 18px 18px;
		pointer-events: none;
	}

	.project-cover.has-image::before {
		display: none;
	}

	[data-theme="light"] .project-cover::before {
		background-image: radial-gradient(
			rgba(0, 0, 0, 0.06) 1px,
			transparent 1px
		);
	}

	.project-mono {
		font-size: 5.5rem;
		font-weight: 800;
		letter-spacing: -0.06em;
		color: var(--p-color);
		line-height: 0.85;
		font-feature-settings: "ss01";
		mix-blend-mode: screen;
		filter: brightness(1.4) saturate(1.2);
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
		position: relative;
		z-index: 1;
		align-self: center;
		justify-self: center;
		margin: 0.2rem 0;
	}

	[data-theme="light"] .project-mono {
		mix-blend-mode: normal;
		filter: none;
		color: var(--p-color);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
	}

	.project-year-cover {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--text-primary);
		opacity: 0.7;
		letter-spacing: 0.02em;
		position: relative;
		z-index: 1;
	}

	.project-cat {
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-primary);
		opacity: 0.85;
		position: relative;
		z-index: 1;
	}

	.project-tags {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
		list-style: none;
		padding: 0.85rem 1rem;
		margin: 0;
		flex: 1;
	}

	.project-tags li {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--text-secondary);
		line-height: 1.2;
		position: relative;
		padding-left: 0.85rem;
	}

	.project-tags li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.4rem;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--p-color);
		opacity: 0.75;
	}

	.project-body {
		padding: 1.5rem 1.75rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.6rem;
	}

	.project-titlebar {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.project-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.project-title a {
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.project-title a:hover {
		color: var(--accent);
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
		padding-top: 0.15rem;
	}

	.project-link {
		color: var(--text-muted);
		display: inline-flex;
		align-items: center;
		transition: color 0.2s ease;
	}

	.project-link:hover {
		color: var(--accent);
	}

	.project-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.65;
		margin-top: 0.25rem;
	}

	.project-more {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
		margin-top: 0.4rem;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		width: fit-content;
		transition: gap 0.2s ease;
	}

	.project-more:hover {
		gap: 0.55rem;
	}

	@media (max-width: 700px) {
		.project {
			grid-template-columns: 1fr;
		}

		.project-side {
			border-right: none;
			border-bottom: 1px solid var(--rule);
		}

		.project-cover {
			min-height: 130px;
		}

		.project-mono {
			font-size: 3.5rem;
		}

		.project-tags {
			flex-direction: row;
			flex-wrap: wrap;
			padding: 0.85rem 1.25rem;
		}
	}
</style>
