---
import GitHub from "./icons/GitHub.astro";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

type Category = "Freelance" | "Personal" | "Investigación";

interface Project {
	title: string;
	short: string;
	description: string;
	tags: string[];
	color: string;
	category: Category;
	year?: string;
	github?: string;
	url?: string;
}

const projects: Project[] = [
	{
		title: "Sistema Contable",
		short: "SC",
		description:
			"Digitalización modular de una oficina de contabilidad que aún trabaja con papel. Reemplazó libros físicos de seguimiento mensual (renta, IVA, F29) y fichas de clientes por una plataforma con la información centralizada. Sigue en evolución.",
		tags: ["NestJS", "TypeScript", "PostgreSQL", "Coolify"],
		color: "#ef4444",
		category: "Freelance",
		year: "En curso"
	},
	{
		title: "Akiba Stands",
		short: "AK",
		description:
			"Plataforma para gestionar postulaciones y asignación de los ~80 stands de Akiba Fest, evento anual de cultura japonesa en Valdivia. Reemplazó cientos de correos y planillas por postulación, selección, mapa de disponibilidad y confirmación de pago.",
		tags: ["Express", "TypeScript", "PostgreSQL", "Docker", "CapRover"],
		color: "#f59e0b",
		category: "Freelance",
		year: "2025"
	},
	{
		title: "Completr",
		short: "C",
		description:
			"Aplicación web para hacer seguimiento a videojuegos: pendientes, jugando, completados o abandonados. Inspirada en Trakt pero enfocada en gaming, con un sistema de ratio (puntaje / duración) que prioriza qué jugar primero. Actualmente en beta cerrada.",
		tags: ["Express", "PostgreSQL", "Angular", "PWA", "CapRover"],
		color: "#8b5cf6",
		category: "Personal",
		year: "Beta Cerrada",
		url: "https://www.completr.app"
	},
	{
		title: "SMC2SFC2",
		short: "SF",
		description:
			"Conversor de ROMs de SNES entre formatos .smc y .sfc que funciona completamente en el navegador. Fork de un proyecto abandonado hace 10 años, migrado de JS + Flask a Astro. Añadí drag & drop, procesamiento múltiple, lectura de metadatos, deduplicación con SHA-256 y soporte PWA.",
		tags: ["Astro", "TypeScript", "PWA", "CapRover"],
		color: "#06b6d4",
		category: "Personal",
		year: "2024",
		github: "https://github.com/etejedaw/smc2sfc2",
		url: "https://smc2sfc2.app.etejeda.dev"
	},
	{
		title: "CORE Model",
		short: "CM",
		description:
			"Sistema que recopila datos de múltiples fuentes institucionales para calcular indicadores de resiliencia comunitaria. Los resultados se visualizan en dashboards que ayudan a investigadores a identificar dónde invertir para mejorar la preparación municipal. Tesis FONDECYT.",
		tags: ["TypeScript", "Node.js", "Web Scraping", "Metabase"],
		color: "#3b82f6",
		category: "Investigación",
		year: "2022",
		github: "https://github.com/etejedaw/coremodel-fondecyt-node"
	},
	{
		title: "Wayback Scraping",
		short: "WB",
		description:
			'Extracción de millones de registros históricos desde Wayback Machine sobre el mercado laboral en EE.UU. durante la pandemia. Base del paper "From automation to home production via the gig economy" del Prof. Luis Ignacio Valenzuela.',
		tags: ["TypeScript", "Node.js", "Web Scraping", "Wayback Machine"],
		color: "#10b981",
		category: "Investigación",
		year: "2021",
		github: "https://github.com/etejedaw/caredotcom-fondecyt-node"
	}
];
---

<section class="section" id="proyectos">
	<header class="section-header">
		<h2 class="section-title">Proyectos</h2>
	</header>

	<div class="projects">
		{
			projects.map(project => (
				<article class="project" style={`--p-color: ${project.color};`}>
					<div class="project-side">
						<div class="project-cover" aria-hidden="true">
							{project.year && (
								<span class="project-year-cover">
									{project.year}
								</span>
							)}
							<span class="project-mono">{project.short}</span>
							<span class="project-cat">{project.category}</span>
						</div>
						<ul class="project-tags">
							{project.tags.map(tag => (
								<li>{tag}</li>
							))}
						</ul>
					</div>
					<div class="project-body">
						<div class="project-titlebar">
							<h3 class="project-title">{project.title}</h3>
							<div class="project-links">
								{project.github && (
									<a
										href={project.github}
										target="_blank"
										rel="noopener noreferrer"
										class="project-link"
										aria-label={`GitHub de ${project.title}`}
									>
										<GitHub size={16} />
									</a>
								)}
								{project.url && (
									<a
										href={project.url}
										target="_blank"
										rel="noopener noreferrer"
										class="project-link"
										aria-label={`Ver ${project.title}`}
									>
										<ArrowUpRight size={16} />
									</a>
								)}
							</div>
						</div>
						<p class="project-description">{project.description}</p>
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.projects {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.project {
		display: grid;
		grid-template-columns: 140px 1fr;
		gap: 0;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 14px;
		overflow: hidden;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.project:hover {
		border-color: var(--accent-border);
		transform: translateY(-3px);
		box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.4);
	}

	.project-side {
		display: flex;
		flex-direction: column;
		border-right: 1px solid var(--rule);
	}

	.project-cover {
		position: relative;
		background:
			radial-gradient(
				circle at 30% 20%,
				color-mix(in srgb, var(--p-color) 60%, transparent) 0%,
				transparent 65%
			),
			linear-gradient(
				160deg,
				color-mix(in srgb, var(--p-color) 38%, var(--bg-surface)),
				color-mix(in srgb, var(--p-color) 14%, var(--bg-surface))
			);
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: 0.9rem 1rem;
		min-height: 150px;
		overflow: hidden;
		border-bottom: 1px solid var(--rule);
	}

	.project-cover::before {
		content: "";
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			rgba(255, 255, 255, 0.05) 1px,
			transparent 1px
		);
		background-size: 18px 18px;
		pointer-events: none;
	}

	[data-theme="light"] .project-cover::before {
		background-image: radial-gradient(
			rgba(0, 0, 0, 0.06) 1px,
			transparent 1px
		);
	}

	.project-mono {
		font-size: 5.5rem;
		font-weight: 800;
		letter-spacing: -0.06em;
		color: var(--p-color);
		line-height: 0.85;
		font-feature-settings: "ss01";
		mix-blend-mode: screen;
		filter: brightness(1.4) saturate(1.2);
		text-shadow: 0 2px 16px rgba(0, 0, 0, 0.4);
		position: relative;
		z-index: 1;
		align-self: center;
		justify-self: center;
		margin: 0.2rem 0;
	}

	[data-theme="light"] .project-mono {
		mix-blend-mode: normal;
		filter: none;
		color: var(--p-color);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
	}

	.project-year-cover {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--text-primary);
		opacity: 0.7;
		letter-spacing: 0.02em;
		position: relative;
		z-index: 1;
	}

	.project-cat {
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-primary);
		opacity: 0.85;
		position: relative;
		z-index: 1;
	}

	.project-body {
		padding: 1.5rem 1.75rem;
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.6rem;
	}

	.project-titlebar {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.project-title {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.project-links {
		display: flex;
		gap: 0.75rem;
		flex-shrink: 0;
		padding-top: 0.15rem;
	}

	.project-link {
		color: var(--text-muted);
		display: inline-flex;
		align-items: center;
		transition: color 0.2s ease;
	}

	.project-link:hover {
		color: var(--accent);
	}

	.project-description {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.65;
		margin-top: 0.25rem;
	}

	.project-tags {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4rem;
		list-style: none;
		padding: 0.85rem 1rem;
		margin: 0;
		flex: 1;
	}

	.project-tags li {
		font-family: var(--font-jetbrains-mono), monospace;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--text-secondary);
		line-height: 1.2;
		position: relative;
		padding-left: 0.85rem;
	}

	.project-tags li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.4rem;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: var(--p-color);
		opacity: 0.75;
	}

	@media (max-width: 700px) {
		.project {
			grid-template-columns: 1fr;
		}

		.project-side {
			border-right: none;
			border-bottom: 1px solid var(--rule);
		}

		.project-cover {
			min-height: 130px;
		}

		.project-mono {
			font-size: 3.5rem;
		}

		.project-tags {
			flex-direction: row;
			flex-wrap: wrap;
			padding: 0.85rem 1.25rem;
		}
	}
</style>
