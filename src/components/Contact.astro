---
import GitHub from "./icons/GitHub.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Bell from "./icons/Bell.astro";
import Book from "./icons/Book.astro";
import Mail from "./icons/Mail.astro";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

type IconName = "github" | "linkedin" | "bell" | "book";

interface Link {
	name: string;
	url: string;
	description: string;
	icon: IconName;
}

const iconMap = {
	github: GitHub,
	linkedin: LinkedIn,
	bell: Bell,
	book: Book
};

const links: Link[] = [
	{
		name: "GitHub",
		url: "https://github.com/etejedaw",
		description: "Revisa mi código",
		icon: "github"
	},
	{
		name: "LinkedIn",
		url: "https://www.linkedin.com/in/etejedaw/",
		description: "Conectemos profesionalmente",
		icon: "linkedin"
	},
	{
		name: "Grimorio",
		url: "https://blog.etejeda.dev/#/portal/",
		description: "Suscríbete para recibir cada artículo nuevo por correo",
		icon: "bell"
	},
	{
		name: "Blog",
		url: "https://blog.etejeda.dev",
		description: "Lee mis artículos",
		icon: "book"
	}
];
---

<section class="contact" id="contacto">
	<div class="container">
		<h2 class="section-title">Contacto</h2>
		<p class="section-description">
			Si quieres hablar sobre serverless, integraciones, o simplemente
			intercambiar ideas sobre desarrollo, encuéntrame en estas
			plataformas.
		</p>
		<div class="links-grid">
			<a href="mailto:etejedaw@hotmail.com" class="link-card email-card">
				<div class="link-icon">
					<Mail />
				</div>
				<div class="link-info">
					<span class="link-name">Email</span>
					<span class="link-description">Escríbeme directamente</span>
				</div>
				<ArrowUpRight class="link-arrow" />
			</a>
			{
				links.map(link => {
					const Icon = iconMap[link.icon];
					return (
						<a
							href={link.url}
							target="_blank"
							rel="noopener noreferrer"
							class="link-card"
						>
							<div class="link-icon">
								<Icon />
							</div>
							<div class="link-info">
								<span class="link-name">{link.name}</span>
								<span class="link-description">
									{link.description}
								</span>
							</div>
							<ArrowUpRight class="link-arrow" />
						</a>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.contact {
		padding: 6rem 1.5rem;
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}

	.section-title::after {
		content: "";
		display: block;
		width: 48px;
		height: 3px;
		background: var(--accent);
		margin-top: 0.75rem;
		border-radius: 2px;
	}

	.section-description {
		color: var(--text-secondary);
		font-size: 1.05rem;
		margin-bottom: 3rem;
		margin-top: 1rem;
		max-width: 550px;
	}

	.links-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.email-card {
		grid-column: 1 / -1;
		border-color: rgba(var(--accent-rgb), 0.2);
		background: rgba(var(--accent-rgb), 0.04);
	}

	.email-card:hover {
		border-color: rgba(var(--accent-rgb), 0.4);
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		background: rgba(var(--overlay-rgb), 0.02);
		border: 1px solid rgba(var(--overlay-rgb), 0.06);
		border-radius: 12px;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.link-card:hover {
		border-color: rgba(var(--accent-rgb), 0.3);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	}

	.link-icon {
		color: var(--accent-light);
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}

	.link-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		flex: 1;
	}

	.link-name {
		font-weight: 700;
		color: var(--text-primary);
		font-size: 1rem;
	}

	.link-description {
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	.link-arrow {
		color: var(--text-muted);
		flex-shrink: 0;
		transition: all 0.2s ease;
	}

	.link-card:hover .link-arrow {
		color: var(--accent-light);
		transform: translate(2px, -2px);
	}

	@media (max-width: 768px) {
		.links-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
