---
import GitHub from "./icons/GitHub.astro";
import LinkedIn from "./icons/LinkedIn.astro";
import Bell from "./icons/Bell.astro";
import Book from "./icons/Book.astro";
import Mail from "./icons/Mail.astro";
import ArrowUpRight from "./icons/ArrowUpRight.astro";

type IconName = "mail" | "github" | "linkedin" | "bell" | "book";

interface Link {
	name: string;
	url: string;
	description: string;
	icon: IconName;
	external?: boolean;
}

const iconMap = {
	mail: Mail,
	github: GitHub,
	linkedin: LinkedIn,
	bell: Bell,
	book: Book
};

const links: Link[] = [
	{
		name: "Email",
		url: "mailto:contacto@etejeda.dev",
		description: "Escríbeme directamente",
		icon: "mail"
	},
	{
		name: "GitHub",
		url: "https://github.com/etejedaw",
		description: "Mi código",
		icon: "github",
		external: true
	},
	{
		name: "LinkedIn",
		url: "https://www.linkedin.com/in/etejedaw/",
		description: "Conectemos profesionalmente",
		icon: "linkedin",
		external: true
	},
	{
		name: "Newsletter",
		url: "https://blog.etejeda.dev/#/portal/",
		description: "Cada artículo nuevo en tu correo",
		icon: "bell",
		external: true
	},
	{
		name: "Blog",
		url: "https://blog.etejeda.dev",
		description: "Artículos técnicos",
		icon: "book",
		external: true
	}
];
---

<section class="section" id="contacto">
	<header class="section-header">
		<h2 class="section-title">Contacto</h2>
	</header>

	<ul class="links">
		{
			links.map(link => {
				const Icon = iconMap[link.icon];
				const isEmail = link.icon === "mail";
				return (
					<li class={isEmail ? "li-feature" : undefined}>
						<a
							href={link.url}
							target={link.external ? "_blank" : undefined}
							rel={
								link.external
									? "noopener noreferrer"
									: undefined
							}
							class={`link${isEmail ? " link-feature" : ""}`}
						>
							<div class="link-icon">
								<Icon size={isEmail ? 24 : 20} />
							</div>
							<div class="link-text">
								<span class="link-name">{link.name}</span>
								<span class="link-description">
									{link.description}
								</span>
							</div>
							<ArrowUpRight
								class="link-arrow"
								size={isEmail ? 18 : 16}
							/>
						</a>
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.section {
		padding: 0 0 5rem;
		scroll-margin-top: 5rem;
	}

	.section-header {
		position: sticky;
		top: 0;
		z-index: 20;
		padding: 1.25rem 0;
		margin-bottom: 1.5rem;
		background: var(--header-bg);
		backdrop-filter: blur(8px);
	}

	.section-title {
		font-size: 0.78rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-auto-rows: 1fr;
		gap: 0.85rem;
	}

	.links li {
		display: flex;
	}

	.li-feature {
		grid-column: 1 / -1;
	}

	.link-feature {
		background: var(--bg-elevated);
		border-color: var(--accent-border);
		padding: 1.35rem 1.5rem;
	}

	.link-feature .link-icon {
		width: 48px;
		height: 48px;
		border-radius: 10px;
	}

	.link-feature .link-name {
		font-size: 1.05rem;
	}

	.link-feature .link-description {
		font-size: 0.9rem;
	}

	.link-feature .link-arrow {
		color: var(--accent);
	}

	.link {
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 1rem;
		align-items: center;
		padding: 1rem 1.1rem;
		background: var(--bg-surface);
		border: 1px solid var(--rule);
		border-radius: 10px;
		text-decoration: none;
		width: 100%;
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.link:hover,
	.link:focus-visible {
		border-color: var(--accent-border);
		transform: translateY(-2px);
		background: var(--bg-elevated);
	}

	.link-icon {
		width: 36px;
		height: 36px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--accent);
		background: var(--accent-soft);
		border-radius: 8px;
		flex-shrink: 0;
	}

	.link-text {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
	}

	.link-name {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-primary);
		letter-spacing: -0.01em;
	}

	.link-description {
		font-size: 0.8rem;
		color: var(--text-muted);
		line-height: 1.3;
	}

	.link-arrow {
		color: var(--text-muted);
		transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.link:hover .link-arrow {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	@media (max-width: 600px) {
		.links {
			grid-template-columns: 1fr;
		}
	}
</style>
