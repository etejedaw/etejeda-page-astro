---
const links = [
	{
		name: "LinkedIn",
		url: "https://www.linkedin.com/in/etejedaw/",
		description: "Conectemos profesionalmente",
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`
	},
	{
		name: "GitHub",
		url: "https://github.com/etejedaw",
		description: "Revisa mi código",
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>`
	},
	{
		name: "Blog",
		url: "https://blog.etejeda.dev",
		description: "Lee mis artículos",
		icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>`
	}
];
---

<section class="contact" id="contacto">
	<div class="container">
		<h2 class="section-title">Contacto</h2>
		<p class="section-description">
			Si quieres hablar sobre serverless, integraciones, o simplemente
			intercambiar ideas sobre desarrollo, encuéntrame en estas
			plataformas.
		</p>
		<div class="links-grid">
			{
				links.map(link => (
					<a
						href={link.url}
						target="_blank"
						rel="noopener noreferrer"
						class="link-card"
					>
						<div class="link-icon" set:html={link.icon} />
						<div class="link-info">
							<span class="link-name">{link.name}</span>
							<span class="link-description">
								{link.description}
							</span>
						</div>
						<svg
							class="link-arrow"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						>
							<path d="M7 17l9.2-9.2M17 17V7H7" />
						</svg>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.contact {
		padding: 6rem 1.5rem;
		background: rgba(255, 255, 255, 0.01);
	}

	.container {
		max-width: 1100px;
		margin: 0 auto;
	}

	.section-title {
		font-size: 2rem;
		font-weight: 800;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
		letter-spacing: -0.02em;
	}

	.section-title::after {
		content: "";
		display: block;
		width: 48px;
		height: 3px;
		background: var(--accent);
		margin-top: 0.75rem;
		border-radius: 2px;
	}

	.section-description {
		color: var(--text-secondary);
		font-size: 1.05rem;
		margin-bottom: 3rem;
		margin-top: 1rem;
		max-width: 550px;
	}

	.links-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem 1.5rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.link-card:hover {
		border-color: rgba(139, 92, 246, 0.3);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
	}

	.link-icon {
		color: var(--accent-light);
		flex-shrink: 0;
		display: flex;
		align-items: center;
	}

	.link-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		flex: 1;
	}

	.link-name {
		font-weight: 700;
		color: var(--text-primary);
		font-size: 1rem;
	}

	.link-description {
		color: var(--text-muted);
		font-size: 0.8rem;
	}

	.link-arrow {
		color: var(--text-muted);
		flex-shrink: 0;
		transition: all 0.2s ease;
	}

	.link-card:hover .link-arrow {
		color: var(--accent-light);
		transform: translate(2px, -2px);
	}

	@media (max-width: 768px) {
		.links-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
